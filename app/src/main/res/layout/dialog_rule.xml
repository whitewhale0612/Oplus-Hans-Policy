<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/package_layout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/package_name">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/package_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/package_placeholder"
                android:imeOptions="actionNext"
                android:inputType="textNoSuggestions"
                android:maxLines="1"
                android:minHeight="56dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/enabled_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/rule_enabled" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/full_exempt_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/full_exempt" />

        <LinearLayout
            android:id="@+id/advanced_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/HansPolicy.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/section_timing" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/custom_timing_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="48dp"
                android:text="@string/custom_timing" />

            <LinearLayout
                android:id="@+id/timing_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/r_to_m_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/r_to_m_delay"
                    app:suffixText="@string/seconds_suffix">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/r_to_m_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="number"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/m_to_f_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/m_to_f_delay"
                    app:suffixText="@string/seconds_suffix">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/m_to_f_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="number"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <TextView
                style="@style/HansPolicy.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/section_packet_wake" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/packet_wake_mode">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/packet_wake_mode_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:id="@+id/packet_throttle_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/packet_wake_cooldown_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/packet_wake_cooldown"
                    app:suffixText="@string/seconds_suffix">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/packet_wake_cooldown_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="number"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/custom_packet_refreeze_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="48dp"
                android:text="@string/custom_packet_refreeze" />

            <LinearLayout
                android:id="@+id/packet_refreeze_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/packet_refreeze_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/packet_refreeze_delay"
                    app:suffixText="@string/seconds_suffix">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/packet_refreeze_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="number"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <TextView
                style="@style/HansPolicy.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/section_freeze_sources" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/block_normal_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="48dp"
                android:text="@string/freeze_normal" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/block_fast_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/freeze_fast" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/block_super_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/freeze_super" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/block_preload_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/freeze_preload" />

            <TextView
                style="@style/HansPolicy.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/section_resources" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/keep_network_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="48dp"
                android:text="@string/keep_network" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/keep_service_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/keep_service" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/keep_job_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/keep_job" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/keep_broadcast_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/keep_broadcast" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/keep_alarm_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/keep_alarm" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/keep_binder_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/keep_binder" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/keep_sensor_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/keep_sensor" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/keep_gps_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/keep_gps" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/keep_wake_lock_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/keep_wake_lock" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/keep_audio_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/keep_audio" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/keep_bt_scan_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/keep_bt_scan" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
